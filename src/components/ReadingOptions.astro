---
import { Icon } from "astro-icon/components";
---

<div id="readingOptions" class="settings-popover" popover="manual">
  <h2>Reading Options</h2>
  <select name="fontSelect" id="fontSelect" class="textToggle">
    <option value="--font-family-sans"
      >Atkinson Hyperlegible (low vision/default)</option
    >
    <option value="--font-family-fast">Fast (adhd)</option>
    <option value="--font-family-open-dyslexic">Open Dyslexic (dyslexia)</option
    >
  </select>
  <button type="button" class="closeReadingOptions">close</button>
</div>
<button
  id="readingOptionsBtn"
  class="readingOptionsBtn"
  popovertarget="readingOptions"
>
  <Icon name={"radix-icons:gear"} height={24} width={24} />
  <span class="sr-only">Font settings</span>
</button>
<style>
  .textToggle {
    padding: var(--spacing-xs);
    color: var(--color-background);
    background-color: var(--color-text);
    height: max-content;
    font-family: var(--font-family-sans);
  }

  .settings-popover {
    padding: var(--spacing-xs);
    background-color: var(--color-text);
    color: var(--color-background);
    margin: 0 auto;
    top: 20%;
    flex-direction: column;
    max-width: 100%;

    h2 {
      font-size: var(--font-size-18);
    }

    button {
      border: 1px solid var(--color-background);
      margin-top: var(--spacing-xs);
      padding: var(--spacing-xxs) var(--spacing-xs);
      align-self: flex-end;
    }

    &:popover-open {
      display: flex;
    }
  }

  .readingOptionsBtn {
    font-size: var(--font-size-18);
    position: fixed;
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    background-color: var(--color-text);
    color: var(--color-background);
    border-radius: 50%;
    padding: var(--spacing-xs);
  }
</style>
<script>
  document.addEventListener("astro:page-load", () => {
    const fontSettings = localStorage.getItem("fontSettings");
    const popOver = document.getElementById("readingOptions");
    const closeBtn = document.querySelector(".closeReadingOptions");

    const textToggleButton = document.querySelector(".textToggle");
    const contentContainer: HTMLElement =
      document.querySelector(".blog-content")!;
    const swapText = (event: any) => {
      contentContainer.style.fontFamily = `var(${event.target.value})`;
      localStorage.setItem("fontSettings", event.target.value);
    };

    if (fontSettings) {
      contentContainer.style.fontFamily = `var(${fontSettings})`;
    }

    closeBtn?.addEventListener("click", () => popOver?.hidePopover());
    textToggleButton?.addEventListener("change", (event: any) =>
      swapText(event)
    );
  });
</script>
