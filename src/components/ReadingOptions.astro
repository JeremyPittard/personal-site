---
import { Icon } from "astro-icon/components";
---

<div id="readingOptions" class="settings-popover" popover="manual">
  <h2>Reading Options</h2>
  <div class="radio-group">
    <div class="radio-option">
      <input
        type="radio"
        id="sans"
        name="fontSelect"
        value="--font-family-sans"
        checked
      />
      <label for="sans">Atkinson Hyperlegible (low vision/default)</label>
    </div>

    <div class="radio-option">
      <input
        type="radio"
        id="fast"
        name="fontSelect"
        value="--font-family-fast"
      />
      <label for="fast">Fast (adhd)</label>
    </div>

    <div class="radio-option">
      <input
        type="radio"
        id="open-dyslexic"
        name="fontSelect"
        value="--font-family-open-dyslexic"
      />
      <label for="open-dyslexic">Open Dyslexic (dyslexia)</label>
    </div>
  </div>
  <button type="button" class="closeReadingOptions">close</button>
</div>
<button
  id="readingOptionsBtn"
  class="readingOptionsBtn"
  popovertarget="readingOptions"
>
  <Icon name={"radix-icons:gear"} height={24} width={24} />
  <span class="sr-only">Font settings</span>
</button>
<style>
  .textToggle {
    padding: var(--spacing-xs);
    color: var(--color-background);
    background-color: var(--color-text);
    height: max-content;
    font-family: var(--font-family-sans);
  }

  .settings-popover {
    padding: var(--spacing-sm);
    font-size: var(--font-size-16);
    background-color: var(--color-text);
    color: var(--color-background);
    margin: 0 auto;
    top: 20%;
    flex-direction: column;
    max-width: 100%;

    h2 {
      font-size: var(--font-size-18);
    }

    button {
      border: 1px solid var(--color-background);
      margin-top: var(--spacing-xs);
      padding: var(--spacing-xxs) var(--spacing-xs);
      align-self: flex-end;
      border: 1px solid var(--color-background);
      padding: var(--spacing-xxs);
      line-height: 1;
      align-self: flex-end;
      border-radius: var(--border-radius);
    }

    &:popover-open {
      display: flex;
    }
  }

  .readingOptionsBtn {
    font-size: var(--font-size-18);
    position: fixed;
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    background-color: var(--color-text);
    color: var(--color-background);
    border-radius: 50%;
    padding: var(--spacing-xs);
  }
  .radio-option {
    display: flex;
    border: 1px solid var(--color-text-secondary);
    margin-block: var(--spacing-xs);
    label {
      flex: 1;
      padding-inline: var(--spacing-xs);
      cursor: pointer;
    }
    input {
      appearance: none;
      cursor: pointer;
    }

    &:has(input:checked) {
      background-color: var(--color-background);
      color: var(--color-text);
    }
  }
</style>
<script>
  document.addEventListener("astro:page-load", () => {
    const fontSettings = localStorage.getItem("fontSettings") ?? null;
    const popOver = document.getElementById("readingOptions");
    const closeBtn = document.querySelector(".closeReadingOptions");
    const radioBtns: NodeListOf<HTMLInputElement> = document.querySelectorAll(
      "input[name='fontSelect']"
    );

    const contentContainer: HTMLElement =
      document.querySelector(".blog-content")!;
    const swapText = (event: any) => {
      contentContainer.style.fontFamily = `var(${event.target.value})`;
      localStorage.setItem("fontSettings", event.target.value);
    };

    if (fontSettings && contentContainer) {
      contentContainer.style.fontFamily = `var(${fontSettings})`;
    }

    closeBtn?.addEventListener("click", () => popOver?.hidePopover());

    radioBtns?.forEach((radio) => {
      if (radio?.value === fontSettings) {
        radio.checked = true;
      }
      radio?.addEventListener("change", (event: any) => {
        swapText(event);
      });
    });
  });
</script>
