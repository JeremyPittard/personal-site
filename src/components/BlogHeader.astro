---
import Logo from "../assets/logo.svg";
---

<header class="blog-header">
  <nav class="content mx-auto">
    <a href="/" class="home-link">
      <Logo height={60} />
      <span class="sr-only">home</span>
    </a>
  </nav>
</header>
<style>
  header {
    --max-page-width: 35em;

    padding-top: var(--spacing-md);
    background-image: linear-gradient(
      to bottom,
      var(--color-text) 60%,
      var(--color-background) 60%
    );
    margin-bottom: var(--spacing-xl);
  }
  svg {
    margin-left: -18px;
    --svg-fill: var(--color-background);
    --svg-stroke: var(--color-text);
    stroke-width: 4px;
    filter: drop-shadow(4px 4px 0 var(--color-text));

    @media (min-width: 768px) {
      margin-left: -36px;
    }
  }
</style>
