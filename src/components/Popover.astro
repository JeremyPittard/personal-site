---

<div id="readingPreferenceNotification" class="popover" popover="manual">
  <p>
    Hey! Spot that font button? Give it a click to switch between regular fonts
    and ones specially designed for folks with ADHD or dyslexia. Makes reading a
    whole lot easier for some brains!
  </p>
  <button type="button" class="closePopover">Got it!</button>
</div>
<script>
  document.addEventListener("astro:page-load", () => {
    const hasClosedNotification = localStorage.getItem("hasClosedNotification");
    const popOver = document.getElementById("readingPreferenceNotification");
    const closeBtn = document.querySelector(".closePopover");

    const closePopover = () => {
      localStorage.setItem("hasClosedNotification", "true");
      popOver?.hidePopover();
    };

    const showPopover = () => {
      if (hasClosedNotification) {
        return;
      }
      popOver?.showPopover();
    };

    closeBtn?.addEventListener("click", closePopover);

    showPopover();
  });
</script>

<style>
  .popover {
    font-size: 16px;
    color: var(--color-background);
    max-width: var(--max-page-width);
    margin: 0 auto;
    background-color: var(--color-text);
    height: max-content;
    font-family: var(--font-family-sans);
    padding: var(--spacing-xxs) var(--spacing-xs);
    display: flex;
    flex-direction: column;

    button {
      border: 1px solid var(--color-background);
      padding: var(--spacing-xxs) var(--spacing-xs);
      align-self: flex-end;
    }
  }
</style>
