---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<li>
  {tag}
</li>

<style>
  li {
    color: var(--color-background);
    background-color: var(--color-text);
    font-size: var(--font-size-12);
    position: relative;
    padding: var(--spacing-xxs);
    line-height: 1;
    border-radius: 2px;
  }
</style>
