---
import { getCollection } from "astro:content";
import Card from "./Card.astro";

interface Props {
  postsToShow?: number;
  showAllPostsLink?: boolean;
}

const { postsToShow = 10, showAllPostsLink }: Props = Astro.props;
const allBlogPosts = await getCollection("thoughts");

console.log(allBlogPosts);
const featuredPosts = allBlogPosts.filter((post) => post.data.isFeatured);

const sortedPosts = allBlogPosts.sort((a, b) => {
  const dateA = new Date(a?.data?.publishDate ?? 0);
  const dateB = new Date(b?.data?.publishDate ?? 0);
  return dateB.getTime() - dateA.getTime();
});
---

<>
  <section class="blog-list">
    <div class="head">
      <h2>Latest thoughts:</h2>
      {
        showAllPostsLink ? (
          <a href="/thoughts" class="see-all">
            See all thoughts
          </a>
        ) : null
      }
      {allBlogPosts.length === 0 ? <h2>nothing to see here</h2> : null}
    </div>
    <ul>
      {
        featuredPosts.length > 0 ? (
          <Card data={featuredPosts[0].data} featured={true} />
        ) : null
      }
      {
        sortedPosts.map((post, index) => {
          if (index >= postsToShow) return null;
          return <Card data={post.data} />;
        })
      }
    </ul>
  </section>
</>
<style>
  .blog-list {
    margin-block: var(--spacing-xl);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  h2 {
    font-family: var(--font-body);
    margin-bottom: var(--spacing-xs);
  }

  .see-all {
    font-size: var(--font-size-12);
  }
</style>
