---
import { Icon } from "astro-icon/components";
import TagList from "./TagList.astro";
import { createSlug, formatDate } from "../utils/helpers";

interface Props {
  data: any;
  featured?: boolean;
}

const { data, featured } = Astro.props;

const formattedDate = formatDate(data.publishDate);
---

<li>
  <a class="card__link" href={`/thoughts/${createSlug(data.title)}`}>
    {
      featured ? (
        <p class="featured">
          Pinned thought
          <Icon name={"radix-icons:drawing-pin"} height={12} width={12} />
        </p>
      ) : null
    }
    <div>
      <h3>{data.title}</h3>
      <time datetime={formattedDate}>{formattedDate}</time>
    </div>
    <TagList tags={data.tags} />
  </a>
</li>
<style>
  a {
    display: flex;
    justify-content: space-between;
    margin: 0;
    position: relative;
    padding: var(--spacing-xs);
    border-bottom: 1px solid var(--color-text-secondary);

    &:has(.featured) {
      background: var(--color-text);
      color: var(--color-background);
      border: none;
      border-radius: var(--border-radius);

      time {
        color: var(--color-alto-700);
      }
    }
  }

  h3 {
    margin: 0;
  }

  .featured {
    font-size: var(--font-size-12);
    position: absolute;
    top: var(--spacing-xs);
    right: var(--spacing-xs);

    svg {
      display: inline;
    }
  }
</style>
