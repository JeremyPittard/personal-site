---
export const prerender = false;
import Logo from "../assets/footylogo.svg";
---

<section class="hero p-6">
  <div class="flex-col flex-center py-6">
    <Logo width={72} />
    <h1>Is today a footy score?</h1>
    <table>
      <tr>
        <td>Home Team</td>
        <td class="goals skeleton">04</td>
        <td class="behinds skeleton">02</td>
        <td class="total-score skeleton">26</td>
      </tr>
    </table>
    <h2 class="answer"></h2>
  </div>
</section>
<style>
  .hero {
    color: var(--color-tan);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 70vh;
    align-items: center;
    text-align: center;
    background-color: var(--color-primary);
    margin-bottom: var(--spacing-xxl);
    gap: 6px;
    @media (min-width: 768px) {
      font-size: 3.5rem;
    }

    @media (min-width: 1440px) {
      min-height: 85vh;
    }
  }

  p {
    font-size: 2rem;
    line-height: 1.1;
    margin-top: var(--spacing-xl);
    color: var(--color-tan);
    font-family: var(--font-title);

    @media (min-width: 768px) {
      font-size: 3.5rem;
    }

    @media (min-width: 1440px) {
      font-size: 5rem;
    }
  }

  svg {
    --svg-fill: var(--color-primary);
    --svg-stroke: var(--color-background);
    stroke-width: 2px;
    width: 125px;
    filter: drop-shadow(2px 2px 0 var(--color-primary));
    @media (min-width: 1440px) {
      width: 240px;
    }
  }

  .skeleton {
    animation: skeleton 1s ease-in 1s infinite;
    color: transparent;
  }

  table {
    td {
      border: 1px solid var(--color-tan-50);
      padding: var(--spacing-sm);
    }

    td:nth-of-type(1n + 2) {
      @media (min-width: 1440px) {
        font-size: 5rem;
      }
    }
  }

  h2 {
    margin-top: 12px;
    font-size: 3rem;
  }

  @keyframes skeleton {
    0% {
      background-color: var(--color-tan-700);
    }
    50% {
      background-color: var(--color-tan-50);
    }
    100% {
      background-color: var(--color-tan-700);
    }
  }
</style>
<script>
  function updateAFLScore() {
    const now = new Date();
    const goals = now.getDate();
    const behinds = now.getMonth() + 1; // The +1 is non-negotiable for AFL logic!
    const total = now.getFullYear() % 100;

    const goalsElement = document.querySelector(".goals");
    const behindsElement = document.querySelector(".behinds");
    const totalElement = document.querySelector(".total-score");
    const hero = document.getElementById("afl-hero");
    const skeletons = document.querySelectorAll(".skeleton");
    const answerElement = document.querySelector(".answer");

    if (goalsElement && behindsElement && totalElement) {
      setTimeout(() => {
        goalsElement.innerHTML = `${goals.toString().padStart(2, "0")}`;
        behindsElement.innerHTML = `${behinds.toString().padStart(2, "0")}`;
        totalElement.innerHTML = `${total.toString().padStart(2, "0")}`;
        if (skeletons) {
          skeletons.forEach((skeleton) => {
            skeleton.classList.remove("skeleton");
          });
        }
      }, 3000);
    }

    // Apply the "Match" state based on user's local time
    if (answerElement) {
      setTimeout(() => {
        const answer = goals * 6 + behinds === total;
        answerElement.innerHTML = answer ? "✔️" : "❌";
      }, 3000);
    }
  }

  // Run immediately on load
  updateAFLScore();

  // Re-run if using Astro's View Transitions
  document.addEventListener("astro:after-swap", updateAFLScore);
</script>
