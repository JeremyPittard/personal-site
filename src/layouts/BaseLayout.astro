---
import "../styles/main.css";
import "@fontsource/opendyslexic";
import "@fontsource/atkinson-hyperlegible-next";
import "@fontsource-variable/bitter";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description } = Astro.props;
import baseOgImage from "../assets/main-og-image.png";

const ogImage = Astro.props.ogImage || baseOgImage.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:image" content={ogImage} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.2s" })}>
      <slot />
    </div>
    <Footer />
    <script type="text/partytown" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
